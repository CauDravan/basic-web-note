PORT=5000
DATABASE_URL=postgresql://<username>:<password>@localhost:5432/notespace
# MONGO_URI chỉ dùng khi chạy db:migrate-mongo để đọc dữ liệu cũ.
# Lấy key miễn phí tại https://aistudio.google.com/apikey
GEMINI_API_KEY=<your-gemini-api-key>
# Tùy chọn, mặc định gemini-3.8-flash
GEMINI_MODEL=gemini-3.8-flash
